# API pública de ejercicios
EXPO_PUBLIC_API_NINJAS_KEY=tu_api_key_de_api_ninjas

# URL base de tu backend. No pongas aquí credenciales privadas de la base de datos.
# El backend debe exponer:
# GET  /progress/:userId
# PUT  /progress/:userId
EXPO_PUBLIC_DATABASE_API_URL=https://tu-backend.example.com/api
EXPO_PUBLIC_DATABASE_USER_ID=usuario-demo

# Solo las usa el backend; no las expongas con EXPO_PUBLIC_.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=fittrack
DB_USER=root
DB_PASSWORD=root
DATABASE_URL=mysql://root:root@127.0.0.1:3306/fittrack
API_PORT=3000
JWT_SECRET=change-this-secret

# Integracion de viajes. En Expo, EXPO_PUBLIC_* queda incluido en la app.
# Usa estas credenciales solo para pruebas; en produccion mueve OAuth a un proxy backend.
EXPO_PUBLIC_TRAVEL_OAUTH_URL=https://agenda-viajes-laes18-api.azurewebsites.net
EXPO_PUBLIC_TRAVEL_API_URL=https://agenda-viajes-laes18-api.azurewebsites.net/api
EXPO_PUBLIC_TRAVEL_CLIENT_ID=69840cd3-e903-4697-bb8d-62d35d89c2e8
