# API pública de ejercicios
EXPO_PUBLIC_API_NINJAS_KEY=tu_api_key_de_api_ninjas

# URL base de tu backend. No pongas aquí credenciales privadas de la base de datos.
# El backend debe exponer:
# GET  /progress/:userId
# PUT  /progress/:userId
EXPO_PUBLIC_DATABASE_API_URL=https://tu-backend.example.com/api
EXPO_PUBLIC_DATABASE_USER_ID=usuario-demo

# Solo las usa el backend; no las expongas con EXPO_PUBLIC_.
# Usa la cadena Session pooler de Supabase en producción.
DATABASE_URL=
# Ejemplo Supabase: postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres?sslmode=require
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=fittrack
DB_USER=postgres
DB_PASSWORD=postgres
DB_POOL_MAX=10
API_PORT=3000
JWT_SECRET=change-this-secret
# Backend: dominios web permitidos, separados por coma. En producción no uses *.
CORS_ORIGINS=https://tu-app.amplifyapp.com
